---
// Dibujo de pastelillo (provisional, mientras llegan las fotos reales).
// Uso: <Cupcake frosting="#f2b8c6" liner="#8c0d23" />
const { frosting = '#f2b8c6', liner = '#8c0d23', topping = '#b3122e' } = Astro.props;
---
<svg viewBox="0 0 200 220" role="img" aria-label="Pastelillo" class="cupcake">
  <ellipse cx="100" cy="206" rx="62" ry="8" fill="rgba(43,29,26,.08)" />
  <!-- capacillo -->
  <path d="M48 118 L62 200 Q100 210 138 200 L152 118 Z" fill={liner} />
  <path d="M62 118 L70 200 M78 118 L83 203 M94 118 L95 204 M106 118 L105 204 M122 118 L117 203 M138 118 L130 200"
        stroke="rgba(255,255,255,.28)" stroke-width="3" fill="none" />
  <!-- betún -->
  <path d="M40 122 Q34 98 58 92 Q52 66 82 62 Q86 34 112 42 Q138 40 136 66 Q166 70 158 96 Q172 112 158 124 Q100 136 40 122 Z"
        fill={frosting} />
  <path d="M60 96 Q90 88 118 92 M72 70 Q96 64 120 70" stroke="rgba(255,255,255,.55)" stroke-width="5"
        stroke-linecap="round" fill="none" />
  <!-- chispas -->
  <g fill="#fff">
    <rect x="70" y="104" width="10" height="3.5" rx="1.75" transform="rotate(-25 75 105)" />
    <rect x="118" y="100" width="10" height="3.5" rx="1.75" transform="rotate(30 123 101)" />
    <rect x="96" y="78" width="10" height="3.5" rx="1.75" transform="rotate(10 101 79)" />
  </g>
  <!-- cereza -->
  <circle cx="108" cy="36" r="13" fill={topping} />
  <circle cx="103" cy="31" r="4" fill="rgba(255,255,255,.5)" />
  <path d="M110 24 Q116 10 128 8" stroke="#6b3b2a" stroke-width="3" fill="none" stroke-linecap="round" />
</svg>

<style>
  .cupcake { width: 70%; max-width: 220px; height: auto; }
</style>
