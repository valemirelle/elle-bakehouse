---
import Base from '../layouts/Base.astro';
---
<Base>
  <header>
    <h1>Elle Bakehouse</h1>
    <span class="divider" aria-hidden="true"></span>
    <p class="tagline">Fresh bread &amp; pastries, baked daily.</p>
  </header>
  <main>
    <ul class="products">
      <li class="card">Sourdough</li>
      <li class="card">Croissants</li>
      <li class="card">Cinnamon rolls</li>
    </ul>
    <a class="btn" href="mailto:hello@ellebakehouse.com">Order</a>
  </main>
</Base>

<style>
  .products {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 640px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  .products li {
    flex: 1 1 160px;
    padding: 1.6rem 1rem;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.3rem;
  }
</style>
