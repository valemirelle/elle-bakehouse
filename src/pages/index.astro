---
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Elle Bakehouse</title>
    <meta name="description" content="Fresh bread and pastries, baked with love." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;1,500&family=Inter:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header>
      <h1>Elle Bakehouse</h1>
      <span class="divider" aria-hidden="true"></span>
      <p class="tagline">Fresh bread &amp; pastries, baked daily.</p>
    </header>
    <main>
      <ul>
        <li>Sourdough</li>
        <li>Croissants</li>
        <li>Cinnamon rolls</li>
      </ul>
      <a class="btn" href="mailto:hello@ellebakehouse.com">Order</a>
    </main>
    <footer>© Elle Bakehouse</footer>
  </body>
</html>

<style is:global>
  /* Colores de la marca: cambia aquí y se actualiza todo el sitio */
  :root {
    --red: #b3122e;
    --red-dark: #8c0d23;
    --cream: #fbf6ef;
    --blush: #f6e7e4;
    --ink: #2b1d1a;
    --muted: #7a6a66;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    font-family: 'Inter', system-ui, sans-serif;
    background: var(--cream);
    color: var(--ink);
    text-align: center;
    -webkit-font-smoothing: antialiased;
  }

  header {
    padding: 6rem 1.5rem 4.5rem;
    background:
      radial-gradient(circle at 50% 0%, var(--blush) 0%, transparent 70%),
      var(--cream);
  }


  h1 {
    margin: 0;
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    font-size: clamp(2.8rem, 8vw, 5rem);
    line-height: 1.05;
    color: var(--red);
  }

  .divider {
    display: block;
    width: 56px;
    height: 2px;
    margin: 1.75rem auto;
    background: var(--red);
    opacity: .6;
  }

  .tagline {
    margin: 0;
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-size: clamp(1.15rem, 3vw, 1.4rem);
    color: var(--muted);
  }

  main {
    flex: 1;
    padding: 1rem 1.5rem 5rem;
  }

  ul {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 640px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  li {
    flex: 1 1 160px;
    padding: 1.6rem 1rem;
    background: #fff;
    border: 1px solid var(--blush);
    border-radius: 14px;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.3rem;
    box-shadow: 0 6px 18px rgba(43, 29, 26, .06);
    transition: transform .2s ease, box-shadow .2s ease;
  }

  li:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(43, 29, 26, .1);
  }

  .btn {
    display: inline-block;
    margin-top: 3rem;
    padding: .95rem 2.75rem;
    background: var(--red);
    color: #fff;
    font-weight: 500;
    letter-spacing: .08em;
    text-transform: uppercase;
    font-size: .85rem;
    text-decoration: none;
    border-radius: 999px;
    box-shadow: 0 8px 20px rgba(179, 18, 46, .25);
    transition: background .2s ease, transform .2s ease;
  }

  .btn:hover {
    background: var(--red-dark);
    transform: translateY(-2px);
  }

  footer {
    padding: 1.5rem;
    border-top: 1px solid var(--blush);
    color: var(--muted);
    font-size: .85rem;
    letter-spacing: .05em;
  }
</style>
