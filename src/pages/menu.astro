---
import Base from '../layouts/Base.astro';

// ⚠️ DATOS DE PRUEBA (mock): productos inventados. Cámbialos por los reales.
// Sin precios por ahora.
const menu = [
  {
    section: 'Pan',
    items: [
      { name: 'Pan de masa madre', note: 'Corteza crujiente' },
      { name: 'Baguette', note: 'Clásica francesa' },
      { name: 'Brioche', note: 'Suave y con mantequilla' },
    ],
  },
  {
    section: 'Pan dulce',
    items: [
      { name: 'Croissant', note: 'Hojaldrado, de pura mantequilla' },
      { name: 'Rol de canela', note: 'Con glaseado de queso crema' },
      { name: 'Pan de chocolate', note: 'Con chocolate amargo' },
    ],
  },
  {
    section: 'Pasteles',
    items: [
      { name: 'Pastel de chocolate', note: 'Para 10–12 personas' },
      { name: 'Pastel de zanahoria', note: 'Con nuez y queso crema' },
      { name: 'Cupcakes (6)', note: 'Sabores surtidos' },
    ],
  },
];
---
<Base title="Menú · Elle Bakehouse" description="Pan, pan dulce y pasteles de Elle Bakehouse.">
  <header>
    <h1>Menú</h1>
    <span class="divider" aria-hidden="true"></span>
    <p class="tagline">Horneado fresco, hecho por pedido.</p>
  </header>
  <main>
    <div class="sections">
      {menu.map((s) => (
        <section class="card">
          <h2>{s.section}</h2>
          <ul>
            {s.items.map((i) => (
              <li>
                <div>
                  <span class="name">{i.name}</span>
                  <span class="note">{i.note}</span>
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
    <a class="btn" href="mailto:hello@ellebakehouse.com">Hacer un pedido</a>
  </main>
</Base>

<style>
  .sections {
    margin: 0 auto;
    max-width: 960px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
    text-align: left;
  }

  section {
    padding: 1.75rem 1.5rem;
  }

  h2 {
    margin: 0 0 1.25rem;
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    font-size: 1.5rem;
    color: var(--red);
    text-align: center;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: .8rem 0;
    border-top: 1px solid var(--blush);
  }

  li:first-child {
    border-top: none;
  }

  .name {
    display: block;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.1rem;
  }

  .note {
    display: block;
    font-size: .8rem;
    color: var(--muted);
  }

</style>
