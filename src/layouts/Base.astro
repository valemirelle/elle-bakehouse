---
// Plantilla compartida: menú, letras, colores y pie de página de TODAS las páginas.
const { title = 'Elle Bakehouse', description = 'Fresh bread and pastries, baked with love.' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: 'Home' },
  { href: '/menu', label: 'Menu' },
  { href: '/contact', label: 'Contact' },
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;1,500&family=Inter:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <nav>
      {links.map((l) => (
        <a href={l.href} class={path === l.href ? 'active' : ''}>{l.label}</a>
      ))}
    </nav>
    <slot />
    <footer>© Elle Bakehouse</footer>
  </body>
</html>

<style is:global>
  /* Colores de la marca: cambia aquí y se actualiza todo el sitio */
  :root {
    --red: #8c0d23;
    --red-dark: #6b0a1b;
    --cream: #fbf6ef;
    --blush: #f6e7e4;
    --ink: #2b1d1a;
    --muted: #7a6a66;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    font-family: 'Inter', system-ui, sans-serif;
    background: var(--cream);
    color: var(--ink);
    text-align: center;
    -webkit-font-smoothing: antialiased;
  }

  nav {
    display: flex;
    justify-content: center;
    gap: 2rem;
    padding: 1.4rem 1rem 0;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: .8rem;
    letter-spacing: .2em;
    text-transform: uppercase;
    padding-bottom: .3rem;
    border-bottom: 1px solid transparent;
    transition: color .2s ease, border-color .2s ease;
  }

  nav a:hover,
  nav a.active {
    color: var(--red);
    border-color: var(--red);
  }

  header {
    padding: 5rem 1.5rem 4.5rem;
    background:
      radial-gradient(circle at 50% 0%, var(--blush) 0%, transparent 70%),
      var(--cream);
  }

  h1 {
    margin: 0;
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    font-size: clamp(2.8rem, 8vw, 5rem);
    line-height: 1.05;
    color: var(--red);
  }

  .divider {
    display: block;
    width: 56px;
    height: 2px;
    margin: 1.75rem auto;
    background: var(--red);
    opacity: .6;
  }

  .tagline {
    margin: 0;
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-size: clamp(1.15rem, 3vw, 1.4rem);
    color: var(--muted);
  }

  main {
    flex: 1;
    padding: 1rem 1.5rem 5rem;
  }

  .btn {
    display: inline-block;
    margin-top: 3rem;
    padding: .95rem 2.75rem;
    background: var(--red);
    color: #fff;
    font-weight: 500;
    letter-spacing: .08em;
    text-transform: uppercase;
    font-size: .85rem;
    text-decoration: none;
    border-radius: 999px;
    box-shadow: 0 8px 20px rgba(140, 13, 35, .25);
    transition: background .2s ease, transform .2s ease;
  }

  .btn:hover {
    background: var(--red-dark);
    transform: translateY(-2px);
  }

  .card {
    background: #fff;
    border: 1px solid var(--blush);
    border-radius: 14px;
    box-shadow: 0 6px 18px rgba(43, 29, 26, .06);
    transition: transform .2s ease, box-shadow .2s ease;
  }

  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(43, 29, 26, .1);
  }

  footer {
    padding: 1.5rem;
    border-top: 1px solid var(--blush);
    color: var(--muted);
    font-size: .85rem;
    letter-spacing: .05em;
  }
</style>
