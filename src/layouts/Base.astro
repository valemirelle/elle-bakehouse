---
// Plantilla compartida: menú, letras, colores y pie de página de TODAS las páginas.
const {
  title = 'Elle Bakehouse',
  description = 'Pan, pastelería y repostería hechos con amor en la Ciudad de México.',
} = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: 'Inicio' },
  { href: '/menu', label: 'Menú' },
  { href: '/contact', label: 'Contacto' },
];
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Parisienne&family=Playfair+Display:ital,wght@0,500;0,600;1,500&family=Inter:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <nav>
      <a href="/" class="brand">Elle Bakehouse</a>
      <div class="links">
        {links.map((l) => (
          <a href={l.href} class={path === l.href ? 'active' : ''}>{l.label}</a>
        ))}
      </div>
    </nav>
    <slot />
    <footer>
      <div class="foot">
        <div>
          <p class="foot-brand">Elle Bakehouse</p>
          <p>Gracias por apoyar a un negocio familiar.</p>
        </div>
        <div>
          <h4>Entregas</h4>
          <p>A domicilio: martes a sábado</p>
          <p>Perisur: sábados, 12:30</p>
        </div>
        <div>
          <h4>Pedidos</h4>
          <p><a href="mailto:hello@ellebakehouse.com">hello@ellebakehouse.com</a></p>
        </div>
        <div>
          <h4>Síguenos</h4>
          <!-- ⚠️ Pon aquí los links reales de redes sociales -->
          <p class="social"><a href="#">Instagram</a> · <a href="#">Facebook</a></p>
        </div>
      </div>
      <p class="copy">© Elle Bakehouse</p>
    </footer>
  </body>
</html>

<style is:global>
  /* Colores de la marca: cambia aquí y se actualiza todo el sitio */
  :root {
    --red: #8c0d23;
    --red-dark: #6b0a1b;
    --rose: #d9a5a0;
    --cream: #fdf8f4;
    --blush: #f7e9e4;
    --ink: #2b1d1a;
    --muted: #7a6a66;
    --script: 'Parisienne', cursive;
    --serif: 'Playfair Display', Georgia, serif;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    font-family: 'Inter', system-ui, sans-serif;
    background: var(--cream);
    color: var(--ink);
    text-align: center;
    -webkit-font-smoothing: antialiased;
  }

  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1.2rem clamp(1rem, 4vw, 3rem);
    border-bottom: 1px solid var(--blush);
    background: rgba(253, 248, 244, .9);
  }

  nav .brand {
    font-family: var(--script);
    font-size: 1.9rem;
    color: var(--red);
    text-decoration: none;
  }

  nav .links {
    display: flex;
    gap: 1.75rem;
  }

  nav .links a {
    color: var(--muted);
    text-decoration: none;
    font-size: .78rem;
    letter-spacing: .2em;
    text-transform: uppercase;
    padding-bottom: .3rem;
    border-bottom: 1px solid transparent;
    transition: color .2s ease, border-color .2s ease;
  }

  nav .links a:hover,
  nav .links a.active {
    color: var(--red);
    border-color: var(--red);
  }

  header {
    padding: 4.5rem 1.5rem 4rem;
    background:
      radial-gradient(circle at 50% 0%, var(--blush) 0%, transparent 70%),
      var(--cream);
  }

  h1 {
    margin: 0;
    font-family: var(--script);
    font-weight: 400;
    font-size: clamp(3.2rem, 9vw, 5.5rem);
    line-height: 1.05;
    color: var(--red);
  }

  .divider {
    display: block;
    width: 56px;
    height: 2px;
    margin: 1.5rem auto;
    background: var(--rose);
  }

  .tagline {
    margin: 0;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.1rem, 3vw, 1.35rem);
    color: var(--muted);
  }

  main {
    flex: 1;
    padding: 1rem 1.5rem 5rem;
  }

  .btn {
    display: inline-block;
    margin-top: 2.5rem;
    padding: .95rem 2.5rem;
    background: var(--red);
    color: #fff;
    font: inherit;
    font-weight: 500;
    letter-spacing: .08em;
    text-transform: uppercase;
    font-size: .82rem;
    text-decoration: none;
    border: none;
    border-radius: 999px;
    cursor: pointer;
    box-shadow: 0 8px 20px rgba(140, 13, 35, .22);
    transition: background .2s ease, transform .2s ease;
  }

  .btn:hover {
    background: var(--red-dark);
    transform: translateY(-2px);
  }

  .card {
    background: #fff;
    border: 1px solid var(--blush);
    border-radius: 16px;
    box-shadow: 0 6px 18px rgba(43, 29, 26, .06);
    transition: transform .2s ease, box-shadow .2s ease;
  }

  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(43, 29, 26, .1);
  }

  /* Espacio para foto: reemplazar por <img src="..."> cuando haya fotos reales */
  .photo {
    display: grid;
    place-items: center;
    min-height: 260px;
    border-radius: 16px;
    background:
      radial-gradient(circle at 30% 30%, #fff 0%, transparent 55%),
      linear-gradient(135deg, var(--blush), #f0d6d1);
    color: var(--red);
    font-family: var(--serif);
    font-style: italic;
    font-size: .95rem;
    opacity: .9;
  }

  footer {
    background: var(--blush);
    color: var(--muted);
    font-size: .88rem;
    text-align: left;
  }

  .foot {
    max-width: 1080px;
    margin: 0 auto;
    padding: 3rem 1.5rem 2rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 2rem;
  }

  .foot h4 {
    margin: 0 0 .6rem;
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1rem;
    color: var(--ink);
  }

  .foot p { margin: .25rem 0; }

  .foot a { color: var(--red); text-decoration: none; }

  .foot-brand {
    font-family: var(--script);
    font-size: 2rem;
    color: var(--red);
    margin: 0 0 .25rem !important;
  }

  .copy {
    margin: 0;
    padding: 1rem;
    text-align: center;
    border-top: 1px solid rgba(140, 13, 35, .1);
    font-size: .8rem;
    letter-spacing: .05em;
  }
</style>
